---
// One drawn arrow, turned by a class. Drawn rather than typed so it has the
// same weight as the rules around it, looks the same before and after the
// web fonts arrive, and never sends the browser hunting through system fonts
// for a glyph the fallback face does not have.
interface Props {
  to?: 'right' | 'left' | 'up' | 'down' | 'out';
  /** The arrow comes before its label. */
  lead?: boolean;
}
const { to = 'right', lead = false } = Astro.props;
---

<svg class:list={['arrow', `arrow--${to}`, lead && 'arrow--lead']} viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M1 6h10M6.5 1.5 11 6l-4.5 4.5"></path></svg>
