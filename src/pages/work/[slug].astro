---
import Arrow from '../../components/Arrow.astro';
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import { fileNumber, projects, site, work, type Project } from '../../content';
import Base from '../../layouts/Base.astro';

export function getStaticPaths() {
  return projects.map((project, position) => ({ params: { slug: project.slug }, props: { project, position } }));
}

interface Props {
  project: Project;
  position: number;
}
const { project, position } = Astro.props;

const images = import.meta.glob<{ default: ImageMetadata }>('../../assets/work/*.{png,jpg,jpeg,webp,avif}', { eager: true });
const plates = project.figures.flatMap((figure) => {
  const found = images[`../../assets/work/${figure.file}`];
  return found ? [{ ...figure, src: found.default }] : [];
});

const total = projects.length;
const previous = projects[(position + total - 1) % total];
const next = projects[(position + 1) % total];
const candidates: { label: string; value: string | null; prose?: boolean }[] = [
  { label: work.labels.kind, value: project.kind },
  { label: work.labels.year, value: project.year },
  { label: work.labels.status, value: project.status },
  { label: work.labels.role, value: project.role, prose: true },
  { label: work.labels.stack, value: project.stack.join(' · ') },
];
// A field with no confirmed value is left off the page, never guessed.
const facts = candidates.flatMap((row) => (row.value === null ? [] : [{ ...row, value: row.value }]));

const path = `/work/${project.slug}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.purpose,
  url: new URL(path, site.url).href,
  author: { '@type': 'Person', name: site.name, url: `${site.url}/` },
  keywords: project.stack.join(', '),
};
---

<Base title={`${project.title} · ${site.name}`} description={project.purpose} path={path} jsonLd={jsonLd}>
  <article class="dossier">
    <header class="wrap dossier__head">
      <p class="dossier__crumb">
        <a class="label" href="/#work">
          <Arrow to="left" lead />
          {work.labels.all}
        </a>
        <span class="data muted">{`${work.labels.file} ${fileNumber(position)} / ${fileNumber(total - 1)}`}</span>
      </p>
      <h1 class="dossier__title" data-vt={`file-${project.slug}`}>{project.title}</h1>
      <p class="dossier__descriptor label muted">{project.descriptor}</p>
      <div class="dossier__intro">
        <p class="dossier__purpose">{project.purpose}</p>
        <dl class="spec">
          {
            facts.map((row) => (
              <div class="spec__row">
                <dt class="label muted">{row.label}</dt>
                <dd class={row.prose ? 'file__prose' : 'data'}>{row.value}</dd>
              </div>
            ))
          }
          {
            project.links.length > 0 && (
              <div class="spec__row">
                <dt class="label muted">{work.labels.links}</dt>
                <dd class="file__links">
                  {project.links.map((link) => (
                    <a class="label" href={link.href} rel="noopener">
                      {link.label}
                      <Arrow to="out" />
                    </a>
                  ))}
                </dd>
              </div>
            )
          }
        </dl>
      </div>
    </header>

    {
      project.metrics.length > 0 && (
        <section class="wrap part" aria-labelledby="part-figures">
          <h2 class="label part__label" id="part-figures">{work.labels.metrics}</h2>
          <ul class="figures part__body">
            {project.metrics.map((metric) => (
              <li class="figure">
                <span class="figure__value">{metric.value}</span>
                <span class="label muted">{metric.label}</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="wrap part" aria-labelledby="part-overview">
      <h2 class="label part__label" id="part-overview">{work.labels.overview}</h2>
      <div class="part__body prose">
        <p class="prose__lead">{project.overview}</p>
        <h3 class="label muted">{work.labels.built}</h3>
        <ul class="ruled">
          {project.built.map((line) => <li>{line}</li>)}
        </ul>
      </div>
    </section>

    {
      plates.length > 0 && (
        <section class="wrap part" aria-labelledby="part-plates">
          <h2 class="label part__label" id="part-plates">{work.labels.plates}</h2>
          <div class="part__body plates">
            {plates.map((figure, index) => (
              <figure class="plate">
                <Picture
                  src={figure.src}
                  alt={figure.alt}
                  formats={['avif', 'webp']}
                  fallbackFormat="jpg"
                  widths={[480, 800, 1200, 1600]}
                  sizes="(min-width: 64rem) 66vw, 92vw"
                  quality={62}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption>
                  <span class="data muted">{`${work.labels.plate} ${fileNumber(index)}`}</span>
                  <span>{figure.caption}</span>
                </figcaption>
              </figure>
            ))}
          </div>
        </section>
      )
    }

    {
      project.system.length > 0 && (
        <section class="wrap part" aria-labelledby="part-system">
          <h2 class="label part__label" id="part-system">{work.labels.system}</h2>
          <ol class="steps part__body">
            {project.system.map((step, index) => (
              <li class="step">
                <span class="data muted">{fileNumber(index)}</span>
                <div>
                  <h3 class="step__title">{step.title}</h3>
                  <p>{step.body}</p>
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    {
      project.specs.length > 0 && (
        <section class="wrap part" aria-labelledby="part-specs">
          <h2 class="label part__label" id="part-specs">{work.labels.specs}</h2>
          <dl class="spec part__body">
            {project.specs.map((row) => (
              <div class="spec__row">
                <dt class="label muted">{row.label}</dt>
                <dd>{row.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )
    }

    {
      project.limits.length > 0 && (
        <section class="wrap part" aria-labelledby="part-limits">
          <h2 class="label part__label" id="part-limits">{work.labels.limits}</h2>
          <ul class="ruled part__body">
            {project.limits.map((line) => <li>{line}</li>)}
          </ul>
        </section>
      )
    }

    <nav class="wrap dossier__nav" aria-label={work.title}>
      {
        previous && (
          <a href={`/work/${previous.slug}/`} rel="prev">
            <span class="label muted">
              <Arrow to="left" lead />
              {work.labels.previous}
            </span>
            <span class="dossier__navtitle">{previous.title}</span>
          </a>
        )
      }
      {
        next && (
          <a href={`/work/${next.slug}/`} rel="next">
            <span class="label muted">
              {work.labels.next}
              <Arrow />
            </span>
            <span class="dossier__navtitle">{next.title}</span>
          </a>
        )
      }
    </nav>
  </article>
</Base>
